import pygame
import random

pygame.init()
W, H = 540, 600
C = 60
F = pygame.font.SysFont("Arial", 36)

CL = {
    'W': (255, 255, 255),
    'B': (0, 0, 0),
    'G': (150, 150, 150),
    'BL': (100, 150, 255),
    'LB': (200, 220, 255),
    'R': (119, 0, 4),
    'GR': (32, 153, 0)
}

class S:
    def __init__(self):
        self.g = [[((i*3 + i//3 + j)%9 + 1) for j in range(9)] for i in range(9)]
        self.s = [r[:] for r in self.g]
        self.f = [[True]*9 for _ in range(9)]

    def tr(self):
        self.g = list(map(list, zip(*self.g)))
        self.s = list(map(list, zip(*self.s)))

    def sr(self):
        a = random.randrange(3)
        l1, l2 = random.sample(range(3), 2)
        r1, r2 = a*3 + l1, a*3 + l2
        self.g[r1], self.g[r2] = self.g[r2], self.g[r1]
        self.s[r1], self.s[r2] = self.s[r2], self.s[r1]

    def sc(self):
        self.tr(); self.sr(); self.tr()

    def sra(self):
        a1, a2 = random.sample(range(3), 2)
        for i in range(3):
            r1, r2 = a1*3 + i, a2*3 + i
            self.g[r1], self.g[r2] = self.g[r2], self.g[r1]
            self.s[r1], self.s[r2] = self.s[r2], self.s[r1]

    def sca(self):
        self.tr(); self.sra(); self.tr()

    def m(self, t=20):
        fs = [self.tr, self.sr, self.sc, self.sra, self.sca]
        for _ in range(t): random.choice(fs)()

    def r(self, c=40):
        cs = [(i,j) for i in range(9) for j in range(9)]
        random.shuffle(cs)
        for i,j in cs[:c]:
            self.g[i][j] = 0
            self.f[i][j] = False

def main():
    sc = pygame.display.set_mode((W, H))
    pygame.display.set_caption("Sudoku")
    ck = pygame.time.Clock()

    s = S()
    s.m()
    s.r()

    sl = None
    rn = True
    wn = False

    while rn:
        sc.fill(CL['W'])

        for i in range(10):
            th = 3 if i%3==0 else 1
            pygame.draw.line(sc, CL['B'], (i*C, 0), (i*C, 540), th)
            pygame.draw.line(sc, CL['B'], (0, i*C), (540, i*C), th)

        if sl:
            r, c = sl
            x, y = c*C, r*C
            pygame.draw.rect(sc, CL['BL'], (x, y, C, C), 3)
            br, bc = r//3*3, c//3*3
            pygame.draw.rect(sc, CL['LB'], (bc*C+1, br*C+1, 3*C-2, 3*C-2))

        for i in range(9):
            for j in range(9):
                n = s.g[i][j]
                if n:
                    cl = CL['B'] if s.f[i][j] else (CL['GR'] if n == s.s[i][j] else CL['R'])
                    t = F.render(str(n), True, cl)
                    sc.blit(t, t.get_rect(center=(j*C + C//2, i*C + C//2)))

        br = pygame.Rect(0, 540, W, 60)
        pygame.draw.rect(sc, CL['G'], br)
        bt = F.render("Новый", True, CL['B'])
        sc.blit(bt, bt.get_rect(center=br.center))

        if wn:
            wt = F.render("Победа!", True, CL['GR'])
            sc.blit(wt, (W//2 - wt.get_width()//2, 270))

        for e in pygame.event.get():
            if e.type == pygame.QUIT: rn = False
            elif e.type == pygame.MOUSEBUTTONDOWN:
                x, y = e.pos
                if y < 540: sl = (y//C, x//C)
                else:
                    s = S()
                    s.m()
                    s.r()
                    sl = None
                    wn = False
            elif e.type == pygame.KEYDOWN and sl:
                r, c = sl
                if not s.f[r][c]:
                    if e.key in (pygame.K_BACKSPACE, pygame.K_DELETE): s.g[r][c] = 0
                    elif pygame.K_1 <= e.key <= pygame.K_9: s.g[r][c] = e.key - pygame.K_0

        if not wn and all(s.g[i][j] == s.s[i][j] for i in range(9) for j in range(9)): wn = True

        pygame.display.flip()
        ck.tick(30)

    pygame.quit()

if __name__ == "__main__":
    main()

